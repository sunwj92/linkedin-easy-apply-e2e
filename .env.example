# ---------------------------------------------------------------------------
# Run mode
# ---------------------------------------------------------------------------
# 0 = run against the bundled, LinkedIn-DOM-compatible fixture (default, no account needed)
# 1 = run against https://www.linkedin.com (requires storage state files, see README)
LINKEDIN_LIVE=0

# Browser channels used by the generated projects (comma separated):
#   chromium | chrome | msedge
# "chrome" and "msedge" use the locally installed stable browsers.
BROWSER_CHANNELS=chrome,msedge

# Session strategy:
#   storage-state  = reuse a saved storage state (fast, default)
#   per-test-login = log in again for each test (fallback when persistence is impossible)
SESSION_STRATEGY=storage-state

# Allow a UI login when the stored session is missing/expired (local dev only).
ALLOW_UI_LOGIN=0

# Directory holding <user>.json storage state files.
AUTH_DIR=.auth

# Headed run for local debugging.
HEADED=0

# ---------------------------------------------------------------------------
# Mock fixture users (used when LINKEDIN_LIVE=0)
# ---------------------------------------------------------------------------
MOCK_BASE_URL=http://127.0.0.1:4321
MOCK_PORT=4321
MOCK_PASSWORD=demo1234

# ---------------------------------------------------------------------------
# Live LinkedIn users (used when LINKEDIN_LIVE=1)
# Prefer storage states generated by `npm run auth:save`; passwords are only
# needed when ALLOW_UI_LOGIN=1 and should be supplied through CI secrets.
# ---------------------------------------------------------------------------
# LINKEDIN_USER_A_EMAIL=
# LINKEDIN_USER_A_PASSWORD=
# LINKEDIN_USER_B_EMAIL=
# LINKEDIN_USER_B_PASSWORD=
